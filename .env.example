USERS_SERVICE_URL=http://users:8081
FILES_SERVICE_URL=http://files:8082
NOTIFICATIONS_SERVICE_URL=http://notifications:8083

CASSANDRA_CLUSTER_NAME=drive-cluster
CASSANDRA_MAX_HEAP=512M
CASSANDRA_HEAP_NEWSIZE=128M

CASSANDRA_HOSTS=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=notifications
CORS_ALLOWED_ORIGINS=http://localhost:5173

MONGO_URI=mongodb://mongo:27017
MONGO_DB=users
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@filestorage.local
SMTP_USERNAME=
SMTP_PASSWORD=
APP_BASE_URL=http://localhost:5173
CONFIRMATION_TOKEN_TTL=24h
DEFAULT_STORAGE_QUOTA_BYTES=5368709120
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
SESSION_TTL=24h
# Development only. Use a long random value in any shared environment.
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789
PASSWORD_RESET_TOKEN_TTL=15m
AUTH_EMAIL_COOLDOWN=60s
